# Supabase Configuration
SUPABASE_URL=https://your-supabase-project.supabase.co
SUPABASE_PUBLIC_KEY=your_supabase_public_key_here
SUPABASE_SECRET_KEY=your_supabase_secret_key_here
SUPABASE_JWT_SECRET=your_supabase_jwt_secret_here

# Qdrant Vector DB Configuration (Placeholders)
QDRANT_URL=https://your-qdrant-cluster-url:6333
QDRANT_API_KEY=your_qdrant_api_key_here

# External API Configuration Placeholders
LASTFM_API_KEY=your_lastfm_api_key_here
DISCOGS_USER_TOKEN=your_discogs_user_token_here
GROQ_API_KEY=your_groq_api_key_here

# Backend Server Configuration
HOST=0.0.0.0
PORT=8000
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
